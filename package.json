{
  "name": "juritj",
  "version": "0.0.1",
  "description": "JURITJ",
  "author": "Cour de Cassation",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "format": "prettier \"src/**/*.ts\" --check",
    "start": "ts-node src/server.ts",
    "start:watch": "nodemon --watch 'src/**' --ext 'ts,json' --exec 'npx ts-node src/server.ts'",
    "start:docker": "docker compose up -d",
    "stop:docker": "docker compose stop",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "jest && npm run test:integration",
    "test:watch": "jest --watch",
    "test:integration": "jest --config ./jest-integration.json --runInBand",
    "fix": "npm audit --omit=dev && eslint \"src/**/*.ts\" --fix && prettier \"src/**/*.ts\" --write"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "axios": "1.21.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongodb": "7.8.0",
    "multer": "2.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@smithy/util-stream": "4.8.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@types/uuid": "11.0.0",
    "aws-sdk-client-mock": "4.1.0",
    "aws-sdk-client-mock-jest": "4.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-mock-extended": "4.0.2",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/.jest/setupEnvVars.ts"
    ]
  }
}
